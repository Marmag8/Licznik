<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Licznik.Views.AddCounter"
             Title="Dodaj Licznik">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Entry x:Name="Name" Placeholder="Nazwa licznika" />
        <Entry x:Name="InitialValue" Placeholder="Wartość początkowa" Keyboard="Numeric" />
        <!--  <Slider x:Name="R" Minimum="0" Maximum="256" />
        <Slider x:Name="G" Minimum="0" Maximum="256" />
        <Slider x:Name="B" Minimum="0" Maximum="256" />  -->
        <Button Text="Dodaj licznik" Clicked="OnConfirm" />
    </VerticalStackLayout>
</ContentPage>